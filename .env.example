# Barad-dûr — environment for the POC stack.
#
#   cp .env.example .env
#   python3 -c 'import secrets; print(secrets.token_hex(32))'   # for each secret
#
# Do not commit `.env`. Nothing here is a real credential.

# ── platform ─────────────────────────────────────────────────────────────────
# The password of the `barad` Postgres role created on first boot.
barad_db_password=change-me-postgres
# The API key the console and the CLI present. 64 hex chars.
SHAURON_BARAD_KEY=change-me-64-hex
# Used once to claim the first owner account in the console.
BOOTSTRAP_TOKEN=change-me-bootstrap
PLATFORM_API_BIND=127.0.0.1
PLATFORM_API_PORT=8090
CONSOLE_PORT=8092
POSTGRES_PORT=5432

# ── the lab (compose.demo.yaml) ──────────────────────────────────────────────
# juice-shop.demo resolves to this address inside the workers and the API.
# Point it at the machine that serves the demo front.
POC_TARGET_IP=127.0.0.1
# The folder `scripts/poc_demo/tls_front.sh` writes the lab CA and certificate to.
# It is mounted read-only at /lab-tls: the field agent trusts this CA instead of
# skipping verification, so `curl` must find it here.
POC_TLS_DIR=/absolute/path/to/poc-juice-shop/tls
# Where the lab repositories and state.json live. Defaults to
# ~/HUB/Workspace/Councilbox/CYB/poc-juice-shop in the scripts.
# POC_DIR=/absolute/path/to/poc-juice-shop
# Who owns the seeded project, asset and cycle (an existing owner's email).
# POC_OWNER=you@example.com

# ── scanners (only if you run them) ──────────────────────────────────────────
DT_DB_PASSWORD=change-me
DTRACK_API_KEY=change-me
DD_DB_PASSWORD=change-me
DD_SECRET_KEY=change-me
DD_ADMIN_PASSWORD=change-me
DD_CREDENTIAL_AES_256_KEY=change-me
TRIVY_SERVER_TOKEN=change-me
